{
  "name": "magic-wallet-recovery",
  "version": "0.1.0",
  "description": "Open-source tools to check a Bleap Magic Wallet and move funds out of it on your own, without Bleap's services.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "magic-wallet-recovery": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "web": "vite build --config web/vite.config.ts && vite preview --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
